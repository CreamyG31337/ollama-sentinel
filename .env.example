# COPY THIS FILE TO ".env" IN THE PROJECT ROOT (or to
# %APPDATA%\ollama-sentinel\.env on Windows, or
# ~/.config/ollama-sentinel/.env on Linux).
# NEVER commit ".env".
# Git ignores ".env" and ".env.*" except these example files.
# Do not `git add -f .env`. HF_TOKEN and hostnames stay local.

OLLAMA_URL=http://127.0.0.1:11434
# Do not set this to 0.0.0.0 — that is Ollama's bind address, not a client URL.
POLL_INTERVAL=5
PAGING_UTIL_PCT=85
PAGING_POWER_FRAC=0.60
# Leave PAGING_POWER_W unset unless you measured a better absolute watt cutoff.
# If set, it overrides the fraction above.
# PAGING_POWER_W=
PAGING_POLLS=3
VRAM_PRESSURE=0.95
# GPU=              # empty = all GPUs; or 0, 1, ...
# HF_TOKEN=
PROC_VRAM=1
PROC_VRAM_INTERVAL=30
PROC_VRAM_MIN_MB=64
# Gaming yield (Windows tray/GUI only). Detection logs by default; unload is opt-in.
GAMING_YIELD=0
GAMING_YIELD_OBSERVE=1
GAMING_YIELD_INTERVAL=12
GAMING_YIELD_EXCLUDE=SolitaireCollection
GAMING_YIELD_MIN_VRAM_MB=1536
GAMING_YIELD_MIN_UTIL=50
GAMING_YIELD_BUSY_UTIL=20
# Metrics history (in-memory ring buffer; no extra GPU polls)
METRICS=1
METRICS_HISTORY_SEC=3600
METRICS_MAX_SAMPLES=720
# METRICS_LOG=%LOCALAPPDATA%/ollama-sentinel/metrics.jsonl
